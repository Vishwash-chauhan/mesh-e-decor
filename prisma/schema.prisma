generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  price        String
  numericPrice Float
  category     String
  categories   String   @default("[]") // JSON array string of category tags
  image        String   // Cover image (1:1)
  images       String   @default("[]") // JSON array of additional gallery image URLs (1:1)
  description  String?
  material     String?
  dimensions   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
